{
  "name": "curfew",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "uv sync --all-packages --group dev && uv run pre-commit install",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "curfew-core",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "CURFEW_ROOT_TOKEN": "dev-token-not-secure",
    "CURFEW_DB_PATH": "${containerWorkspaceFolder}/state.sqlite"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "skellock.just"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
